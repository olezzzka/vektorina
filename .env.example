# Скопируй в .env и заполни. .env в .gitignore — ключи в гит не попадают.

# ElevenLabs (нужен только если собираешь с --engine elevenlabs).
# Ключ: elevenlabs.io → значок профиля → API Keys → Create.
# voice_id: страница голоса в библиотеке → кнопка ID (или три точки → Copy voice ID).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Модель. По умолчанию eleven_multilingual_v2 — она уверенно говорит по-русски.
# Можно поставить другую, если появится новее.
ELEVENLABS_MODEL=
